# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Saída de build local (android/ e ios/ em si são versionados neste projeto,
# mas o que o Gradle/Xcode geram a cada build não deve ser — além de inútil,
# carrega caminho absoluto da máquina local e já quebrou um build na nuvem
# da EAS por causa disso)
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/app/.cxx/
android/local.properties
ios/build/
ios/Pods/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
